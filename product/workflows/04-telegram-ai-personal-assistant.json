    {
      "parameters": {},
      "id": "316f9c1b-9490-5966-998f-4217d79f8117",
      "name": "Calculator",
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        2860,
        950
      ]
    },
    {
      "parameters": {
        "jsCode": "// Converts the AI answer (markdown) into Telegram-safe HTML so formatting\n// never breaks the message, and prepares a plain-text version for voice replies.\nconst trigger = $('Telegram Trigger').item.json.message || {};\nconst raw = String($json.output || '').trim() || \"Sorry, I couldn't come up with an answer. Please try again.\";\nconst md = raw.length > 3800 ? raw.slice(0, 3800) + '…' : raw;\n\nconst escapeHtml = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst blocks = [];\nlet html = md.replace(/```[\\w+-]*\\n?([\\s\\S]*?)```/g, (m, codeText) => {\n  blocks.push('<pre>' + escapeHtml(codeText.trim()) + '</pre>');\n  return `\\u0000${blocks.length - 1}\\u0000`;\n});\nhtml = escapeHtml(html)\n  .replace(/`([^`\\n]+)`/g, '<code>$1</code>')\n  .replace(/\\[([^\\]\\n]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, (m, text, url) => `<a href=\"${url.replace(/\"/g, '&quot;')}\">${text}</a>`)\n  .replace(/^#{1,6}\\s+(.+)$/gm, '<b>$1</b>')\n  .replace(/^(\\s*)[-*•]\\s+/gm, '$1• ')\n  .replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<b>$1</b>')\n  .replace(/__([^_\\n]+)__/g, '<b>$1</b>')\n  .replace(/(^|[\\s(])\\*([^*\\n]+)\\*(?=[\\s).,!?:;]|$)/g, '$1<i>$2</i>')\n  .replace(/~~([^~\\n]+)~~/g, '<s>$1</s>')\n  .replace(/\\u0000(\\d+)\\u0000/g, (m, i) => blocks[Number(i)]);\n\nconst plain = md\n  .replace(/```[\\w+-]*\\n?([\\s\\S]*?)```/g, '$1')\n  .replace(/\\[([^\\]]+)\\]\\((https?:[^)]+)\\)/g, '$1')\n  .replace(/\\*\\*([^*\\n]+)\\*\\*/g, '$1')\n  .replace(/__([^_\\n]+)__/g, '$1')\n  .replace(/(^|[\\s(])\\*([^*\\n]+)\\*(?=[\\s).,!?:;]|$)/g, '$1$2')\n  .replace(/`([^`\\n]+)`/g, '$1')\n  .replace(/~~([^~\\n]+)~~/g, '$1')\n  .replace(/^#{1,6}\\s+/gm, '')\n  .replace(/^\\s*[-*•]\\s+/gm, '')\n  .trim();\n\nreturn {\n  json: {\n    chat_id: trigger.chat ? trigger.chat.id : null,\n    html,\n    plain: plain.slice(0, 4000),\n    input_type: trigger.voice ? 'voice' : trigger.photo ? 'photo' : 'text',\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
      "id": "643574ae-569f-5387-82c3-48eafcb0e015",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
