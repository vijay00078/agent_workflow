    {
      "parameters": {
        "promptType": "define",
        "text": "=TOPIC: {{ $json.Topic }}\nPRIMARY KEYWORD: {{ $json['Primary Keyword'] || $json.Topic }}\nAUDIENCE: {{ $json.Audience || $('Config').first().json.default_audience }}\nNOTES: {{ $json.Notes || 'none' }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a senior SEO strategist. Create a winning content brief for a blog article.\nBrand: {{ $('Config').first().json.brand_name }}. Language: {{ $('Config').first().json.language }}.\n- title: compelling, max 60 characters, contains the primary keyword naturally.\n- slug: short, lowercase, hyphenated, contains the primary keyword.\n- meta_description: 140–155 characters, includes the keyword, promises a clear benefit.\n- secondary_keywords: 5–8 related terms people also search for.\n- search_intent: informational, commercial, transactional or navigational — plus one sentence on what the searcher really wants.\n- outline: 5–8 H2 sections in a logical order, each with 2–4 key points and optional H3s. Cover the topic better than the current top results.\n- faq: 4–5 real questions people ask about this topic.\n- takeaways: 3–5 one-line key takeaways."
            }
          ]
        },
        "hasOutputParser": true
      },
      "id": "7db639f1-fb31-5ea7-a8f3-7fef7c0695ca",
      "name": "AI: SEO Brief",
