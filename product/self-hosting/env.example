# Copy this file to ".env" (cp env.example .env) and fill in your values.

# The address of your n8n (a DNS "A record" pointing to this server)
DOMAIN=n8n.yourdomain.com

# Your email, for the free HTTPS certificate from Let's Encrypt
ACME_EMAIL=you@yourdomain.com

# Your time zone (schedules run in this zone), e.g. America/New_York, Europe/London, Asia/Kolkata
TIMEZONE=Europe/London

# Encrypts your saved credentials. Create one with:  openssl rand -hex 32
# KEEP IT SAFE: without it, credentials can't be decrypted after a reinstall.
N8N_ENCRYPTION_KEY=paste-a-long-random-string-here
